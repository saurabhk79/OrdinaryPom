{
  "manifest_version": 3,
  "name": "OrdinaryPom",
  "description": "A minimal Pomodoro timer with screen-fatigue protection.",
  "version": "0.1.0",
  "permissions": ["storage", "notifications", "alarms", "offscreen"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_title": "OrdinaryPom",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ]
}
